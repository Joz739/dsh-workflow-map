{
  "name": "dsh-workflow-map",
  "version": "0.3.8",
  "description": "DeepSeek Harness（DSH）插件：把会话折叠成分步工作流地图，逐步显示状态、工具与文件类型；进度百分比标注来源（待办表/自报/时间基线/计划步序），而不是只报一个数；支持把提示词排入下一步队列，被取用前可撤回。",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Joz739",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-0.2.1",
    "cordis",
    "plugin",
    "bundle",
    "workflow",
    "progress",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joz739/dsh-workflow-map.git"
  },
  "homepage": "https://github.com/Joz739/dsh-workflow-map#readme",
  "bugs": {
    "url": "https://github.com/Joz739/dsh-workflow-map/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-loop": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/OPEN-SOURCE-GUIDE.md",
    "docs/host-compatibility.md",
    "docs/screenshot.png",
    "docs/screenshot-detail.png",
    "docs/screenshots",
    "docs/assets",
    "screenshots.json",
    "package.json"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node tools/selftest-fold.mjs && node tools/selftest-host.mjs && node tools/selftest-orchestrator.mjs && node tools/selftest-shape.mjs && node tools/selftest-panel.mjs && node tools/selftest-detail.mjs && node tools/selftest-effects.mjs && node tools/selftest-settings.mjs && node tools/probe-route.mjs && node tools/probe-steer.mjs",
    "test:real": "node tools/check-real-injects.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
